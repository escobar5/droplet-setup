# Copy to droplet.env, edit, then: sudo ./droplet-setup.sh --config droplet.env
# Sourced as bash: KEY="value", no spaces around '='. Keep this file out of git if it holds passwords.

# Steps: comma-separated or "all" -> base,hardening,nginx,postgres,node,pm2,ssl
STEPS="all"
ASSUME_YES="no"                 # "yes" = never prompt; fail if something required is missing

# --- base ---
NEW_USER="deploy"               # Linux user, sudoer, Postgres role, pm2 owner
NEW_USER_PASSWORD=""            # needed for sudo; leave empty to be prompted
SSH_PUBLIC_KEY=""               # extra key, merged with root's authorized_keys
TIMEZONE="UTC"                  # keep servers on UTC; convert in the app
SWAP_SIZE="2G"                  # 0 = no swap
DISABLE_ROOT_LOGIN="yes"
DISABLE_PASSWORD_AUTH="yes"     # skipped automatically if NEW_USER has no SSH key

# --- nginx ---
DOMAINS="example.com www.example.com"   # first = primary (cert name, vhost file name)
APP_PORT="3000"
CLIENT_MAX_BODY_SIZE="10m"

# --- postgres ---
PG_VERSION=""                   # empty = Ubuntu's version; e.g. "18" = apt.postgresql.org
PG_CREATE_DB="yes"              # database named after NEW_USER
PG_PASSWORD=""                  # empty = peer auth over the socket only
PG_TUNE="yes"                   # size memory settings from RAM; restarts Postgres only if values change
PG_MAX_CONNECTIONS="50"         # sum of all app pool sizes + ~5 for psql/cron

# --- node ---
NODE_MAJOR="lts"                # or a major, e.g. "24"

# --- ssl ---
LE_EMAIL="you@example.com"
LE_STAGING="no"                 # "yes" while testing to avoid Let's Encrypt rate limits
HSTS_MAX_AGE="31536000"         # 1 year; 0 disables. Start with 300 if unsure
HSTS_INCLUDE_SUBDOMAINS="no"    # "yes" only if EVERY subdomain serves HTTPS
